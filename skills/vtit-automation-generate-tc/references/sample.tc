    {
      "id": "57376d97-feb0-4a68-a794-173f3af5b2c5",
      "comment": "",
      "output": "",
      "input": {
        "target": "const value1 = {{input.value}};\r\nconst value2 = {{input.value2}};\r\nconst idBox = {{var.idBox}};\r\nlet andCondition = '';\r\nif(value1) {\r\n    andCondition += `contains(normalize-space(), '${value1}')`;\r\n}\r\nif(value2) {\r\n    andCondition += `${andCondition ? 'or ' : ''}contains(normalize-space(), '${value2}')`;\r\n}\r\nreturn `//ul[@id=\"${idBox}-popup-list-listUl\"]//li//div[contains(@class, 'sapMSLITitle') ${andCondition ? 'and (' + andCondition + ')' : ''}]`",
        "value": "xpathSelectOption"
      },
      "takeScreenShot": false,
      "isBreakpoint": false,
      "continueError": false,
      "keyword": "executeScript",
      "disable": false,
      "name": "Execute script",
      "import": "",
